NODE_ENV=development
PORT=4000

# MongoDB must run as a replica set (transactions). For a throwaway local one: npm run db:dev -w server
MONGODB_URI=mongodb://127.0.0.1:27018/inventory?replicaSet=rs0

# Long random strings, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Set to true when served over HTTPS. Always on when NODE_ENV=production.
COOKIE_SECURE=false
# The web app origin, used for the CSRF Origin check
CLIENT_ORIGIN=http://localhost:5173
# Base URL used in email links
APP_URL=http://localhost:5173

# Telegram bot (from @BotFather). All three are required in production.
# No token in development: start tokens and codes are logged, and
# `npm run tg:start -w server -- <startToken> <telegramId> "<name>" [username]` presses Start.
# BOT_MODE: polling (development) or webhook (production; Telegram calls
# APP_URL/api/telegram/webhook with TELEGRAM_WEBHOOK_SECRET in a header; 1-256 characters
# of A-Z, a-z, 0-9, _ and -, for example from `openssl rand -hex 32`).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
BOT_MODE=polling

# Comma-separated admin bootstrap lists (milestone 4)
ADMIN_TELEGRAM_IDS=
ADMIN_EMAILS=

# SMTP (optional in development: emails are logged; required in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
