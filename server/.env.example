NODE_ENV=development
PORT=4000

# MongoDB must run as a replica set (transactions). For a throwaway local one: npm run db:dev -w server
MONGODB_URI=mongodb://127.0.0.1:27018/inventory?replicaSet=rs0

# Long random strings, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Set to true when served over HTTPS. Always on when NODE_ENV=production.
COOKIE_SECURE=false
# The web app origin, used for the CSRF Origin check
CLIENT_ORIGIN=http://127.0.0.1:5173
# Base URL used in email links
APP_URL=http://127.0.0.1:5173
# Reverse proxies in front of the API (0 = none). Set to 1 behind one proxy, or every limit
# is shared by all users.
TRUST_PROXY=0

# Telegram bot (from @BotFather). All three are required in production.
# No token in development: start tokens and codes are logged, and
# `npm run tg:start -w server -- <startToken> <telegramId> "<name>" [username]` presses Start.
# BOT_MODE: polling (development) or webhook (production; Telegram calls
# APP_URL/api/telegram/webhook with TELEGRAM_WEBHOOK_SECRET in a header; 1-256 characters
# of A-Z, a-z, 0-9, _ and -, for example from `openssl rand -hex 32`).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
BOT_MODE=polling

# Comma-separated admin bootstrap lists (milestone 4)
ADMIN_TELEGRAM_IDS=
ADMIN_EMAILS=

# SMTP (optional in development: emails are logged; required in production).
# Brevo (intended provider), nothing in the code is Brevo-specific:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587          (STARTTLS; 465 uses implicit TLS)
#   SMTP_USER=<the SMTP login shown in Brevo under SMTP & API>
#   SMTP_PASS=<an SMTP key created in Brevo, not the account password>
#   EMAIL_FROM="Inventory <no-reply@your-domain>"  (a sender Brevo has verified)
# Before launch follow docs/launch-checklist.md (SPF, DKIM and a real delivery check).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Brevo HTTPS API, instead of SMTP (Render's free instances block outbound SMTP ports).
# When set, the SMTP_* variables are not needed; EMAIL_FROM still is.
# Create the key in Brevo under SMTP & API > API keys.
BREVO_API_KEY=

# send (default) or log. log writes emails and their links to the server log instead of sending,
# so production can run with no email provider (a demo; read the links in the host's logs).
EMAIL_DELIVERY=send
