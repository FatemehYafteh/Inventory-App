{
  "name": "@inventory/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:dev": "node scripts/dev-db.js",
    "user:create": "node --env-file=.env scripts/create-user.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "seed:reset": "node --env-file=.env scripts/seed.js --reset",
    "seed:demo-reset": "node --env-file=.env scripts/seed-demo-reset.js",
    "tg:start": "node --env-file=.env scripts/tg-start.js",
    "tg:webhook": "node --env-file=.env scripts/telegram-webhook.js",
    "db:migrate-initial-reason": "node --env-file=.env scripts/db-maintenance.js migrate-initial-reason",
    "db:sync-indexes": "node --env-file=.env scripts/db-maintenance.js sync-indexes",
    "secret:generate": "node scripts/generate-secret.js"
  },
  "dependencies": {
    "@inventory/shared": "*",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.3",
    "grammy": "^1.46.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.12.0",
    "nodemailer": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
